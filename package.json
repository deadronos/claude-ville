{
  "name": "claude-ville",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx claudeville/server.ts",
    "dev:collector": "tsx collector/start.ts",
    "dev:hubreceiver": "tsx hubreceiver/server.ts",
    "dev:frontend": "vite",
    "dev:frontend-pixijs": "vite --host 127.0.0.1 --open /pixijs.html",
    "dev:frontend-voxel": "vite --open /voxel.html",
    "build:frontend": "vite build",
    "widget:build": "cd widget && bash build.sh",
    "widget": "npm run widget:build && open widget/ClaudeVilleWidget.app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "typecheck:tests:baseline": "node scripts/test-typecheck-baseline.mjs",
    "build": "npm run typecheck && npm run build:frontend",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@opencode-ai/models": "^0.0.91",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "better-sqlite3": "^13.0.3",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@swc/core@1.16.12": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
